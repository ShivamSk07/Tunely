# ──────────────────────────────────────────────────────────────
# Tunely — Environment Variables (copy to .env and fill values)
# ──────────────────────────────────────────────────────────────

# PostgreSQL database (Neon, Supabase, PlanetScale, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# Set to your deployed Vercel URL (no trailing slash)
# Example: https://tunely.vercel.app
NEXTAUTH_URL="https://your-app.vercel.app"


# Music API backend base URL (already deployed)
MUSIC_API_URL="https://my-repo-kohl-eta.vercel.app"

# Public app URL (same as NEXTAUTH_URL usually)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
